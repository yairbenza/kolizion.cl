{
  "appId": "cl.kolizion.app",
  "appName": "KOLIZION",
  "webDir": "www",
  "server": {
    "url": "https://kolizion.cl",
    "errorPath": "offline.html",
    "allowNavigation": [
      "kolizion.cl",
      "www.kolizion.cl"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0d0d0d",
    "appendUserAgent": "KolizionApp/1.0",
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      }
    }
  }
}

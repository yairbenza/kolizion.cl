# Copia este archivo a ".env" (sin ".example") y pon tu clave real ahi.
# ".env" nunca se sube a git (esta en .gitignore) -- esta es solo la plantilla.
ANTHROPIC_API_KEY=

# Contraseña para entrar a /admin/tiendas y /admin/clics (panel privado,
# solo para el dueño del proyecto). Elige la que quieras -- si esta vacia,
# el login queda deshabilitado y nadie puede entrar al panel.
ADMIN_PASSWORD=

# Modo debug de Flask -- SOLO en tu computador para desarrollar (recarga
# automatica + errores detallados). Poner en "1" para desarrollo local.
# NUNCA poner esta variable en "1" en el hosting real -- si no esta
# definida (el caso por defecto en produccion), la app ya arranca segura.
KOLIZION_DEBUG=

# Clave para firmar las sesiones (login de admin Y cuentas de usuario).
# Si se deja vacia, app.py genera una al azar -- pero una NUEVA cada vez
# que el servidor arranca, lo que invalida la cookie de sesion de todos los
# que estaban logueados (bug real: "se cierra sesion de Google en cada
# refresh", pasaba en CUALQUIER reinicio del servidor, no solo en
# produccion). Poner un valor fijo aca (ej. `python -c "import secrets;
# print(secrets.token_hex(32))"`) para que las sesiones sobrevivan
# reinicios -- recomendado siempre, no solo en el hosting real.
FLASK_SECRET_KEY=

# Login con Google para cuentas de usuario (ver docs/cuentas.md). Si se
# dejan vacias, el boton "Continuar con Google" no aparece -- el registro
# con correo/contraseña sigue funcionando igual.
#
# Como conseguirlas: console.cloud.google.com -> crear proyecto -> "OAuth
# consent screen" (tipo Externo) -> "Credentials" -> "Create Credentials" ->
# "OAuth client ID" (tipo Aplicacion web). En "Authorized redirect URIs"
# hay que agregar las 2 URLs de vuelta:
#   http://localhost:5000/auth/google/callback   (para probar en tu compu)
#   https://tu-dominio-real.com/auth/google/callback   (cuando tengas el dominio)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo para los scripts de diagnostico diagnostico_koko_conversacion_real*.py:
# el correo cuya conversacion real guardada (data/chats_koko.json) reproducen.
# No lo usa la app en si -- si queda vacio, solo esos 2 scripts avisan y paran.
KOLIZION_DIAG_EMAIL=

# Topes diarios de Koko (IA con costo por mensaje). Opcionales: si se dejan
# vacios se usan los valores por defecto de constantes.py (15 / 100 / 1500).
#   POR_PERSONA: mensajes por correo en 24 h.
#   POR_IP: mensajes por conexion por dia (frena a quien cambia de correo).
#   GLOBAL: total del sitio por dia sumando a todos -- techo de gasto.
KOKO_LIMITE_DIA_POR_PERSONA=
KOKO_LIMITE_DIA_POR_IP=
KOKO_LIMITE_DIA_GLOBAL=
